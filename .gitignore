# Arduino / build artifacts
build/
*.hex
*.elf
*.bin
*.uf2
*.map

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# local source archive (redundant once extracted)
HalloweenProps-files.zip

# WiFi / API credentials — keep secrets out of the (public) repo
secrets.h

# Crystal Oracle - generated by crystal_oracle/tools/build_assets.py (rebuildable)
crystal_oracle/sd_card/
crystal_oracle/assets/.build_cache.json
crystal_oracle/assets/.cache/
crystal_oracle/assets/previews/
crystal_oracle/tools/__pycache__/
# large source video (keep assets/source/{images,voice,sfx,music} tracked)
crystal_oracle/assets/source/video/

# Codex image jobs from tools/make_image_codex.py (logs + copies; installed stills live in assets/source/images)
crystal_oracle/assets/.codex_jobs/

# ElevenLabs API key for tools/make_voice_elevenlabs.py (never commit)
crystal_oracle/tools/.elevenlabs_key

# Still re-takes: kept copies of replaced stills and review candidates (local only)
crystal_oracle/assets/source/images/*.old
crystal_oracle/assets/source/images/review-*/
