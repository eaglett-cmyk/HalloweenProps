    {"id": "awaken_c_1", "group": "awaken_c", "variant": 1, "speaker": "Oracle", "priority": "MVP",
     "text": "Your light is awake. Let's see what it found!", "caption": "Awake!", "delivery": "building excitement"},
    {"id": "greet_r2_1", "group": "greet_r2", "variant": 1, "speaker": "Oracle", "priority": "MVP",
